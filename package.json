{
  "name": "@warppay402/server",
  "version": "1.2.8",
  "description": "Instant MCP Tool & x402 Monetization SDK for Cloudflare Gateway, Base, and Arc Mainnet",
  "homepage": "https://www.warppay402.com",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "openclaw": {
    "type": "mcp-server",
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=1.0.0"
    },
    "build": {
      "openclawVersion": "1.1.0"
    },
    "config": {
      "url": "https://api.warppay402.com/.well-known/mcp.json"
    }
  },
  "license": "MIT",
  "keywords": [
    "x402",
    "mcp",
    "monetization",
    "base",
    "arc",
    "usdc",
    "hono",
    "ai-agents",
    "warppay402",
    "solana",
    "middleware",
    "cloudflare",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warppay402/warppay402-server.git"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepare": "npm run build",
    "test": "vitest run",
    "example": "tsx examples/basic-monetized-server.ts",
    "version": "node -e \"const fs = require('fs'); const op = JSON.parse(fs.readFileSync('openclaw.plugin.json')); op.version = process.env.npm_package_version; fs.writeFileSync('openclaw.plugin.json', JSON.stringify(op, null, 2) + '\\n');\" && git add openclaw.plugin.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@solana/web3.js": "^1.98.4",
    "@xpaysh/x402": "^0.1.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "viem": "^2.55.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
