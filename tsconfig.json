{
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "monetize.ts", "mcpWrapper.ts"],
  "exclude": ["node_modules", "dist"]
}